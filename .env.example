FLASK_ENV=development

SECRET_KEY=votre_cle_secrete_ici

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=nom_de_votre_base
MYSQL_USER=votre_utilisateur

# Les mots de passe sont gérés via Docker secrets dans le dossier secrets/
# Voir secrets/db_password.txt et secrets/db_root_password.txt

# --- Configuration email (Flask-Mail) ---
# Exemple avec Gmail (nécessite un "App Password" si 2FA activé)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=votre_email@gmail.com
MAIL_DEFAULT_SENDER=votre_email@gmail.com
# Le mot de passe est géré via Docker secrets : secrets/mail_password.txt
# En dev local, créer le fichier secrets/mail_password.txt avec le mot de passe SMTP
